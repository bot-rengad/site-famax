# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="fmx-super-secret-key-change-in-production-min-32-characters-long"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Email (configure for production)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@fmx-optimisation.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="FMX Optimisation <noreply@fmx-optimisation.com>"

# Payment (configure for production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."

# External APIs
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Avis clients : bot qui lit le salon d'avis (section "Ils ont testé FMX")
# Token jamais exposé côté client — route serveur /api/reviews uniquement.
DISCORD_BOT_TOKEN=""
DISCORD_REVIEWS_CHANNEL_ID=""
# Salon staff qui reçoit les nouvelles commandes + licences (preuves à vérifier)
# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
# ID utilisateur Discord du propriétaire : devient ADMIN automatiquement à la connexion
ADMIN_DISCORD_ID=""
# Redirect URI à ajouter sur le portail dev : NEXT_PUBLIC_APP_URL + /api/auth/discord/callback

# Anti-bot Cloudflare Turnstile (optionnel — inactif si absent)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."

# Mesure d'audience (optionnel — inactive sans consentement cookies, voir lib/analytics.ts)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
