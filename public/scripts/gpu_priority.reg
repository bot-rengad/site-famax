Windows Registry Editor Version 5.00

; ============================================================
; FMX Optimisation - Registre GPU Priority & Scheduling
; ============================================================
; Optimise la priorite GPU pour les jeux vs bureau
; Gain: +3-8% FPS, latence reduite
; NECESSITE REDÉMARRAGE
; ============================================================

; GPU Priority pour Taches Bureau = 8 (priorité normale)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler\Tasks]
"GPU Priority"=dword:00000008
"GPU Priority Boost"=dword:00000001

; GPU Priority pour Jeux = 6 (priorité PLUS HAUTE que bureau)
; Valeurs: 1=Haute, 2=Au-dessus normale, 4=Normale, 6=Jeux, 8=Bureau
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler\Games]
"GPU Priority"=dword:00000006
"GPU Priority Boost"=dword:00000001

; High SFIO Priority (Serialised File I/O) pour multimedia
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\PriorityControl]
"HighSFIOPriority"=dword:00000001

; Win32PrioritySeparation - Quantum plus long pour foreground
; 0x26 = 38 decimal = Quantum long, foreground boost max
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\PriorityControl]
"Win32PrioritySeparation"=dword:00000026

; ============================================================
; APRES APPLICATION : REDÉMARRER LE PC
; ============================================================